# Varlock schema. Commit this file; keep real secret values in 1Password.
#
# Local project settings that are not secrets can stay in .env.local.
# Secret provider credentials resolve from provider-level items in the DEV vault.
#
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=true)
# @defaultSensitive=false @defaultRequired=false
# ---

# Optional service account token for CI/headless environments.
# Local development can leave this unset and use the 1Password desktop app CLI integration.
# @type=opServiceAccountToken
OP_SERVICE_ACCOUNT_TOKEN=

# Sendblue iMessage bridge credentials.
# @required @sensitive @type=string
SENDBLUE_API_KEY=op(op://DEV/SENDBLUE_API_KEY/credential)

# @required @sensitive @type=string
SENDBLUE_API_SECRET=op(op://DEV/SENDBLUE_API_SECRET/credential)

# Composio integrations API key.
# @sensitive @type=string
COMPOSIO_API_KEY=op(op://DEV/COMPOSIO_API_KEY/credential)

# Optional paid embeddings provider key.
# @sensitive @type=string
OPENAI_API_KEY=op(op://DEV/OPENAI_API_KEY/credential)

# Optional paid embeddings provider key.
# Add this item to the DEV vault before enabling Voyage embeddings.
# @sensitive @type=string
VOYAGE_API_KEY=

# Optional Claude API key override. The default local path uses Claude Code auth.
# @sensitive @type=string
ANTHROPIC_API_KEY=

# PostHog personal API key used for server-side reports.
# POSTHOG_PROJECT_ID and POSTHOG_HOST are not secrets and can stay in .env.local.
# @sensitive @type=string
POSTHOG_API_KEY=op(op://DEV/POSTHOG_API_KEY/credential)

# Shopify Admin API access token (read_orders scope) for the atgbuddies shop.
# Used by the /shop conversion-rate report to count paid orders.
# @sensitive @type=string
SHOPIFY_ADMIN_API_TOKEN=op(op://DEV/SHOPIFY_ADMIN_API_TOKEN/credential)

# Shopify shop domain (e.g. atgbuddies.myshopify.com). Not a secret.
# @type=string
SHOPIFY_SHOP=

# Comma-separated phone numbers (E.164) that receive the weekly store
# conversion report. Falls back to BOOP_USER_PHONE when unset.
# @type=string
SHOP_CONVERSION_REPORT_TO=

# Enable the scheduled fli-backed flight price watch bootstrap.
# @type=string
FLIGHT_PRICE_WATCH_ENABLED=

# Cron schedule for flight price checks. Defaults to daily 9am in the
# configured FLIGHT_PRICE_WATCH_TIMEZONE.
# @type=string
FLIGHT_PRICE_WATCH_SCHEDULE=

# IANA timezone for FLIGHT_PRICE_WATCH_SCHEDULE. Defaults to America/New_York.
# @type=string
FLIGHT_PRICE_WATCH_TIMEZONE=

# JSON array of watched itineraries/deal searches. Keep record locators and
# other booking identifiers out of this value unless a future airline-specific
# integration actually needs them.
# @type=string
FLIGHT_PRICE_WATCHES_JSON=

# Comma-separated phone numbers (E.164) that receive flight price alerts.
# Falls back to BOOP_USER_PHONE when unset.
# @type=string
FLIGHT_PRICE_WATCH_TO=

# Default itinerary rebook threshold when a watch omits minSavings.
# @type=string
FLIGHT_PRICE_MIN_SAVINGS_USD=

# Set true to receive a "no changes" text after every scheduled check.
# @type=string
FLIGHT_PRICE_WATCH_NOTIFY_NO_CHANGE=

# Set true when smoke-testing the handler without sending iMessages.
# @type=string
FLIGHT_PRICE_WATCH_DRY_RUN=

# CardTool bearer token.
# @sensitive @type=string
CARDTOOL_API_KEY=op(op://DEV/CARDTOOL_API_KEY/credential)

# ATG Exec Chat — shared bearer secret. Must match exec-chat's .env.local.
# When unset, the atg-exec integration is not registered.
# @sensitive @type=string
ATG_EXEC_SECRET=

# Override the URL exec-chat is reachable at. Defaults to http://localhost:3005.
# @type=url
ATG_EXEC_URL=

# Local/project configuration. These values can stay in .env.local and are not
# stored in 1Password.
# @type=string
CONVEX_DEPLOYMENT=

# @type=url
CONVEX_URL=

# @type=url
VITE_CONVEX_URL=

# @type=string
SENDBLUE_FROM_NUMBER=

# @type=string
BOOP_MODEL=

# @type=string
BOOP_UPSTREAM_CHECK=

# @type=port
PORT=

# @type=url
PUBLIC_URL=

# @type=string
NGROK_DOMAIN=

# @type=string
SENDBLUE_AUTO_WEBHOOK=

# @type=string
COMPOSIO_USER_ID=

# @type=string
BOOP_CODING_ROOT=

# @type=string
BOOP_CODING_AGENT=

# @type=string
BOOP_CODING_MODEL=

# @type=string
BOOP_CODING_REMOTE_KEEPALIVE_HOURS=

# @type=string
BOOP_CODING_CLI_PATH=

# @type=string
BOOP_CODING_CLAUDE_PATH=

# @type=string
BOOP_CODING_CODEX_PATH=

# @type=string
BOOP_CODING_CODEX_MODEL=

# @type=string
BOOP_CODING_CODEX_REASONING=

# @type=string
BOOP_CODING_CODEX_SERVICE_TIER=

# Optional link included when a Codex coder finishes. Defaults to
# https://chatgpt.com/codex.
# @type=url
BOOP_CODEX_URL=

# Optional per-session Codex URL template. Use {sessionId} as the placeholder if
# OpenAI exposes a stable ChatGPT/Codex session URL format for local CLI sessions.
# @type=string
BOOP_CODEX_SESSION_URL_TEMPLATE=

# @type=string
BOOP_CODING_BUDGET_USD=

# @type=string
POSTHOG_PROJECT_ID=

# @type=url
POSTHOG_HOST=

# @type=string
POSTHOG_REPORT_TO=

# @type=url
CARDTOOL_BASE_URL=

# @type=string
BOOP_USER_PHONE=
